@model AcmeCatalog.Core.Models.Item
@{
    ViewData["Title"] = Model.Name;
}

<a class="text-decoration-none text-muted d-inline-block mb-3" asp-action="Index">&larr; Back to Catalog</a>

<div class="row g-4">
    <div class="col-md-5">
        <img src="@Model.ImageUrl" class="img-fluid rounded-4 shadow-sm" alt="@Model.Name" data-testid="details-image" />
    </div>
    <div class="col-md-7">
        <span class="@CategoryStyleHelper.GetBadgeClass(Model.Category) mb-2" data-testid="details-category">@Model.Category</span>
        <h1 data-testid="details-name">@Model.Name</h1>
        <p class="fs-3 fw-bold item-price" data-testid="details-price">@Model.Price.ToString("C")</p>

        <ul class="nav nav-tabs" id="detailsTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="description-tab" data-bs-toggle="tab" data-bs-target="#description-pane"
                        type="button" role="tab" aria-controls="description-pane" aria-selected="true" data-testid="tab-description">
                    Description
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="specs-tab" data-bs-toggle="tab" data-bs-target="#specs-pane"
                        type="button" role="tab" aria-controls="specs-pane" aria-selected="false" data-testid="tab-specs">
                    Specs
                </button>
            </li>
        </ul>
        <div class="tab-content border border-top-0 p-3 rounded-bottom" id="detailsTabContent">
            <div class="tab-pane fade show active" id="description-pane" role="tabpanel" aria-labelledby="description-tab" data-testid="tab-panel-description">
                <p>@Model.Description</p>
            </div>
            <div class="tab-pane fade" id="specs-pane" role="tabpanel" aria-labelledby="specs-tab" data-testid="tab-panel-specs">
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr><th scope="row">SKU</th><td>ACME-@Model.Id.ToString("D5")</td></tr>
                        <tr><th scope="row">Category</th><td>@Model.Category</td></tr>
                        <tr><th scope="row">Date Added</th><td>@Model.DateAdded.ToString("MMMM d, yyyy")</td></tr>
                        <tr><th scope="row">Catalog Position</th><td>#@(Model.SortOrder + 1)</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id" data-testid="details-edit-btn">Edit</a>
            <a class="btn btn-outline-secondary" asp-action="Index">Back to Catalog</a>
        </div>
    </div>
</div>
