@model IReadOnlyList<AcmeCatalog.Core.Models.Item>

@if (Model.Count == 0)
{
    <div class="col-12">
        <div class="alert alert-info" data-testid="no-results">No items match your filters.</div>
    </div>
}
else
{
    foreach (var item in Model)
    {
        <div class="col-sm-6 col-lg-3 item-card-col" data-item-id="@item.Id" draggable="true" data-testid="item-card">
            <div class="card h-100 item-card">
                <div class="item-card-media">
                    <div class="drag-handle" title="Drag to reorder" data-testid="drag-handle">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><circle cx="6" cy="6" r="2"></circle><circle cx="12" cy="6" r="2"></circle><circle cx="18" cy="6" r="2"></circle><circle cx="6" cy="12" r="2"></circle><circle cx="12" cy="12" r="2"></circle><circle cx="18" cy="12" r="2"></circle><circle cx="6" cy="18" r="2"></circle><circle cx="12" cy="18" r="2"></circle><circle cx="18" cy="18" r="2"></circle></svg>
                        Drag to reorder
                    </div>
                    <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" />
                </div>
                <div class="card-body d-flex flex-column">
                    <span class="@CategoryStyleHelper.GetBadgeClass(item.Category) align-self-start mb-2" data-testid="item-category">@item.Category</span>
                    <h5 class="card-title" data-testid="item-name">@item.Name</h5>
                    <p class="card-text fw-bold item-price" data-testid="item-price">@item.Price.ToString("C")</p>
                    <div class="mt-auto d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-sm btn-outline-primary quick-view-btn"
                                data-item-id="@item.Id" data-testid="quick-view-btn">Quick View</button>
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Items" asp-action="Details" asp-route-id="@item.Id" data-testid="details-link">Details</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Items" asp-action="Edit" asp-route-id="@item.Id" data-testid="edit-link">Edit</a>
                        <button type="button" class="btn btn-sm btn-outline-danger delete-item-btn"
                                data-bs-toggle="modal" data-bs-target="#deleteConfirmModal"
                                data-item-id="@item.Id" data-item-name="@item.Name" data-testid="delete-btn">Delete</button>
                    </div>
                </div>
            </div>
        </div>
    }
}
