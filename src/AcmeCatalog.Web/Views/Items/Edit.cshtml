@model AcmeCatalog.Web.ViewModels.ItemFormViewModel
@{
    ViewData["Title"] = "Edit Item";
}

<a class="text-decoration-none text-muted d-inline-block mb-3" asp-action="Index">&larr; Back to Catalog</a>
<div class="section-eyebrow">Editing</div>
<h1 class="mb-4">Edit Item</h1>

<form asp-controller="Items" asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" novalidate data-testid="item-form" class="bg-white border rounded-4 p-4 p-md-5 shadow-sm">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" data-testid="validation-summary"></div>
    <input type="hidden" asp-for="Id" />

    <div class="row">
        <div class="col-md-7">
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" data-testid="name-input" />
                <span asp-validation-for="Name" class="text-danger" data-testid="name-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" type="number" step="0.01" min="0.01" class="form-control" data-testid="price-input" />
                <span asp-validation-for="Price" class="text-danger" data-testid="price-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Category" class="form-label"></label>
                <select asp-for="Category" class="form-select" data-testid="category-input">
                    <option value="">-- Select a category --</option>
                    @foreach (var cat in Model.CategoryOptions)
                    {
                        <option value="@cat">@cat</option>
                    }
                </select>
                <span asp-validation-for="Category" class="text-danger" data-testid="category-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4" data-testid="description-input"></textarea>
                <span asp-validation-for="Description" class="text-danger" data-testid="description-error"></span>
            </div>
        </div>

        <div class="col-md-5">
            <div class="mb-3">
                <label class="form-label">Item Image</label>
                <div id="image-dropzone" class="border border-2 border-dashed rounded p-4 text-center" data-testid="image-dropzone">
                    <p class="mb-2 text-muted small">Drag and drop a new image here, or click to browse</p>
                    <input asp-for="ImageFile" accept="image/*" class="form-control" data-testid="image-file-input" />
                    <div class="mt-3">
                        <img id="image-preview" src="@Model.ImageUrl" alt="Preview"
                             class="img-thumbnail @(string.IsNullOrEmpty(Model.ImageUrl) ? "d-none" : "")"
                             style="max-height: 150px;" data-testid="image-preview" />
                    </div>
                </div>
                <div class="form-text">Uploading a new image replaces the current one.</div>
            </div>

            <div class="mb-3">
                <label asp-for="ImageUrl" class="form-label"></label>
                <input asp-for="ImageUrl" class="form-control" placeholder="https://..." data-testid="image-url-input" />
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-primary" data-testid="submit-btn">Save Changes</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/item-form.js" asp-append-version="true"></script>
}
