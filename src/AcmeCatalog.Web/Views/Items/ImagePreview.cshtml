@model AcmeCatalog.Core.Models.Item
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@Model.Name - Image Preview</title>
    <style>
        body {
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background: #f8f9fa;
            font-family: -apple-system, Segoe UI, Roboto, Arial, sans-serif;
        }
        img {
            max-width: 100%;
            max-height: 100vh;
            object-fit: contain;
        }
    </style>
</head>
<body>
    <img src="@Model.ImageUrl" alt="@Model.Name" id="preview-image" />
</body>
</html>
