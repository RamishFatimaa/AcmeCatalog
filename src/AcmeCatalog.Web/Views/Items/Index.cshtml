@{
    Layout = null;
    ViewData["Title"] = "Catalog";
}
@*
    Phase 1 of the React migration: the Items experience is now a fully
    client-rendered React app (see clientapp/), not part of the shared Razor
    _Layout. It reads/writes through the JSON API (/api/items, /api/auth)
    rather than these MVC actions, which stay in place for now only as the
    Reorder/Filter/LoadMore/etc. Razor routes still referenced elsewhere are
    retired in a later phase.

    Local dev: run `npm run dev` in clientapp/ and browse its own port
    directly (it proxies /api, /css, /lib, /uploads back to :5274) — this
    view only ever serves the production-built bundle below.
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AcmeCatalog</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div id="root"></div>
    <script type="module" src="~/clientapp-dist/assets/app.js"></script>
</body>
</html>
