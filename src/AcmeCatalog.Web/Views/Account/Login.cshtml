@model LoginViewModel
@{
    ViewData["Title"] = "Log In";
}

<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path><polyline points="10 17 15 12 10 7"></polyline><line x1="15" y1="12" x2="3" y2="12"></line></svg>
        </div>
        <h1 class="h3 mb-1">Welcome back</h1>
        <p class="text-muted mb-4">Log in to add, edit, and reorganize the catalog.</p>

        <form asp-controller="Account" asp-action="Login" method="post" novalidate data-testid="login-form">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" data-testid="login-error-summary"></div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" autocomplete="username" data-testid="login-username-input" />
                <span asp-validation-for="Username" class="text-danger" data-testid="login-username-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" data-testid="login-password-input" />
                <span asp-validation-for="Password" class="text-danger" data-testid="login-password-error"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" data-testid="login-remember-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary w-100" data-testid="login-submit-btn">Log In</button>
        </form>

        <p class="text-center text-muted mt-4 mb-0">
            Don't have an account?
            <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" data-testid="login-register-link">Sign up</a>
        </p>
        <p class="text-center text-muted small mt-2 mb-0">
            Demo credentials: <code>testuser</code> / <code>Test123!</code>
        </p>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
