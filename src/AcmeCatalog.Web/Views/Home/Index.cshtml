@model HomeIndexViewModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero" data-testid="hero-section">
    <div class="hero-eyebrow">Catalog management, done right</div>
    <h1>Keep your catalog organized, searchable, and always up to date.</h1>
    <p class="lead mb-4">
        AcmeCatalog gives small teams a fast, no-fuss way to manage product inventory &mdash;
        add items, organize by category, reorder with a drag, and find anything in seconds.
    </p>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-accent btn-lg" asp-controller="Items" asp-action="Index" id="browse-catalog-btn">Browse Catalog</a>
        @if (SignInManager.IsSignedIn(User))
        {
            <a class="btn btn-outline-light btn-lg" asp-controller="Items" asp-action="Create">+ Add an Item</a>
        }
        else
        {
            <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Register">Create a free account</a>
        }
    </div>
</section>

<div class="stat-strip mb-5 px-2">
    <div class="stat-card" data-testid="stat-item-count">
        <div class="stat-value">@Model.ItemCount</div>
        <div class="stat-label">Items cataloged</div>
    </div>
    <div class="stat-card" data-testid="stat-category-count">
        <div class="stat-value">@Model.CategoryCount</div>
        <div class="stat-label">Categories</div>
    </div>
    <div class="stat-card" data-testid="stat-latest-item">
        <div class="stat-value fs-5">@(Model.LatestItemName ?? "—")</div>
        <div class="stat-label">Most recently added</div>
    </div>
    <div class="stat-card">
        <div class="stat-value fs-5">MVC + REST</div>
        <div class="stat-label">Same data, two ways in</div>
    </div>
</div>

<section class="mb-5">
    <div class="text-center mb-4">
        <div class="section-eyebrow">How it works</div>
        <h2>From browsing to organizing in three steps</h2>
    </div>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="step-card">
                <div class="step-number">1</div>
                <h5>Browse &amp; search</h5>
                <p class="text-muted mb-0">Filter by category or search as you type &mdash; results update instantly, no page reloads.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="step-card">
                <div class="step-number">2</div>
                <h5>Quick view or dig in</h5>
                <p class="text-muted mb-0">Preview an item in a modal, or open the full details page with specs and description tabs.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="step-card">
                <div class="step-number">3</div>
                <h5>Organize your way</h5>
                <p class="text-muted mb-0">Signed-in users can add, edit, delete, and drag-and-drop reorder the whole catalog.</p>
            </div>
        </div>
    </div>
</section>

<section class="mb-5">
    <div class="text-center mb-4">
        <div class="section-eyebrow">Why teams use it</div>
        <h2>Built to stay out of your way</h2>
    </div>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="value-card h-100">
                <div class="value-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                </div>
                <h5 class="card-title">Find anything fast</h5>
                <p class="card-text text-muted">Live search and category filters mean you never scroll through a long list to find one item.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="value-card h-100">
                <div class="value-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 7h13l-3-3M21 17H8l3 3"></path></svg>
                </div>
                <h5 class="card-title">Organize your way</h5>
                <p class="card-text text-muted">Drag cards to reorder your catalog exactly how you want it &mdash; changes save instantly.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="value-card h-100">
                <div class="value-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                </div>
                <h5 class="card-title">Built for teams</h5>
                <p class="card-text text-muted">Browsing stays open to everyone; adding, editing, and deleting requires a signed-in account.</p>
            </div>
        </div>
    </div>
</section>
