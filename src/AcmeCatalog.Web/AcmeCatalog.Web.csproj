<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\AcmeCatalog.Core\AcmeCatalog.Core.csproj" />
    <ProjectReference Include="..\AcmeCatalog.Infrastructure\AcmeCatalog.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    wwwroot/clientapp-dist/ (the React build output) is NOT built as part of
    this project's own MSBuild targets. MSBuild's wwwroot item glob for the
    static web assets manifest (*.staticwebassets.endpoints.json) is evaluated
    once, before any target runs — no BeforeTargets/AfterTargets hook inside a
    single `dotnet publish` invocation runs early enough to make freshly-built
    files show up in it. MapFallbackToFile can still find a file written later
    by walking the filesystem directly, but MapStaticAssets() only resolves
    through that frozen manifest, so anything built mid-publish 404s at
    runtime even though the publish itself reports success (confirmed against
    a real Azure deploy). The only reliable fix is to run `npm ci && npm run
    build` in clientapp/ as its own separate step BEFORE invoking `dotnet
    publish` at all (see .github/workflows/cd.yml) — that way the files exist
    on disk before MSBuild ever starts evaluating this project.
  -->

</Project>
